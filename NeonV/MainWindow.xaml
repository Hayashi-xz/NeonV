                                                                                </StackPanel>

                                                                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                                                                    <Ellipse Width="6" Height="6" Fill="{Binding PingColor}" Margin="0,1,6,0" VerticalAlignment="Center"/>
                                                                                    <TextBlock Text="{Binding PingText}" Foreground="{Binding PingColor}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                                                                                </StackPanel>

                                                                                <TextBlock Grid.Column="4" Text="&#xE76C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11" Foreground="{DynamicResource TextMutedColor}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                                                            </Grid>
                                                                        </Border>
                                                                        <DataTemplate.Triggers>
                                                                            <Trigger SourceName="SubRowRoot" Property="IsMouseOver" Value="True">
                                                                                <Trigger.EnterActions>
                                                                                    <BeginStoryboard>
                                                                                        <Storyboard>
                                                                                            <DoubleAnimation Storyboard.TargetName="SubRowHoverBg" Storyboard.TargetProperty="Opacity" To="0.6" Duration="0:0:0.15"/>
                                                                                        </Storyboard>
                                                                                    </BeginStoryboard>
                                                                                </Trigger.EnterActions>
                                                                                <Trigger.ExitActions>
                                                                                    <BeginStoryboard>
                                                                                        <Storyboard>
                                                                                            <DoubleAnimation Storyboard.TargetName="SubRowHoverBg" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"/>
                                                                                        </Storyboard>
                                                                                    </BeginStoryboard>
                                                                                </Trigger.ExitActions>
                                                                            </Trigger>
                                                                            <DataTrigger Binding="{Binding IsActiveProfile}" Value="True">
                                                                                <Setter TargetName="SubRowActiveBg" Property="Opacity" Value="1"/>
                                                                                <Setter TargetName="SubActiveBar" Property="Opacity" Value="1"/>
                                                                                <DataTrigger.EnterActions>
                                                                                    <BeginStoryboard>
                                                                                        <Storyboard>
                                                                                            <DoubleAnimation Storyboard.TargetName="SubRowActiveBg" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.2"/>
                                                                                            <DoubleAnimation Storyboard.TargetName="SubActiveBar" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.22"/>
                                                                                            <DoubleAnimation Storyboard.TargetName="SubActiveBar" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.2" To="1" Duration="0:0:0.22">
                                                                                                <DoubleAnimation.EasingFunction>
                                                                                                    <CubicEase EasingMode="EaseOut"/>
                                                                                                </DoubleAnimation.EasingFunction>
                                                                                            </DoubleAnimation>
                                                                                        </Storyboard>
                                                                                    </BeginStoryboard>
                                                                                </DataTrigger.EnterActions>
                                                                                <DataTrigger.ExitActions>
                                                                                    <BeginStoryboard>
                                                                                        <Storyboard>
                                                                                            <DoubleAnimation Storyboard.TargetName="SubRowActiveBg" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"/>
                                                                                            <DoubleAnimation Storyboard.TargetName="SubActiveBar" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"/>
                                                                                            <DoubleAnimation Storyboard.TargetName="SubActiveBar" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.2" Duration="0:0:0.18"/>
                                                                                        </Storyboard>
                                                                                    </BeginStoryboard>
                                                                                </DataTrigger.ExitActions>
                                                                            </DataTrigger>
                                                                        </DataTemplate.Triggers>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </Border>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <StackPanel x:Name="EmptySubscriptionsPanel" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed">
                                <TextBlock Text="&#xE774;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="48" Foreground="{DynamicResource OutlineColor}" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                                <TextBlock x:Name="TxtEmptySubsTitle" Text="Нет добавленных подписок" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextColor}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                <TextBlock x:Name="TxtEmptySubsDesc" Text="Нажмите «Добавить подписку» чтобы загрузить список серверов" FontSize="14" Foreground="{DynamicResource TextMutedColor}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <Grid x:Name="ViewSettings" Grid.Row="0" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="TxtSettingsTitle" Grid.Row="0" Text="Настройки" FontSize="32" FontWeight="Bold" Foreground="{DynamicResource TextColor}" Margin="0,0,0,24"/>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="4,4,20,8" Margin="-4,-4,-20,-8">
                            <Grid Margin="0,0,0,2">
                                <Border x:Name="SettingsCardShadow" Background="{DynamicResource PanelColor}" CornerRadius="12" Opacity="0" IsHitTestVisible="False"/>
                                <Border Background="{DynamicResource PanelColor}" CornerRadius="12" Padding="24">
                                    <StackPanel>
                                        <TextBlock x:Name="TxtGroupLaunch" Text="Запуск и работа" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource AccentColor}" Margin="0,0,0,8"/>
                                        <StackPanel Margin="0,0,0,24">
                                            <CheckBox x:Name="ChkAutoStart" Content="Запускать вместе с Windows" Checked="TxtSettings_Changed" Unchecked="TxtSettings_Changed"/>
                                            <CheckBox x:Name="ChkAutoConnect" Content="Автоматически подключать при запуске" IsEnabled="{Binding IsChecked, ElementName=ChkAutoStart}" Checked="TxtSettings_Changed" Unchecked="TxtSettings_Changed" Margin="0,8,0,0"/>
                                            <CheckBox x:Name="ChkStartMinimized" Content="Запускать свернутым в трей" IsEnabled="{Binding IsChecked, ElementName=ChkAutoStart}" Checked="TxtSettings_Changed" Unchecked="TxtSettings_Changed" Margin="0,8,0,0"/>
                                            <CheckBox x:Name="ChkMinimizeToTray" Content="Сворачивать в трей при закрытии" Checked="TxtSettings_Changed" Unchecked="TxtSettings_Changed" Margin="0,8,0,0"/>
                                            <CheckBox x:Name="ChkAutoUpdateSubs" Content="Автообновление подписок при запуске" Checked="TxtSettings_Changed" Unchecked="TxtSettings_Changed" Margin="0,8,0,0"/>
                                            <CheckBox x:Name="ChkUseCustomConfig" Content="Использовать собственный config.json (без перезаписи)" Checked="ChkReconnectSetting_Changed" Unchecked="ChkReconnectSetting_Changed" Margin="0,8,0,0"/>
                                        </StackPanel>

                                        <TextBlock x:Name="TxtGroupAppearance" Text="Внешний вид" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource AccentColor}" Margin="0,0,0,8"/>
                                        <StackPanel Margin="0,0,0,24">
                                            <Grid Margin="0,0,0,16">
                                                <TextBlock x:Name="TxtLangLabel" Text="Язык интерфейса (Language)" FontSize="16" Foreground="{DynamicResource TextColor}" VerticalAlignment="Center"/>
                                                <ComboBox x:Name="CmbLanguage" Width="250" HorizontalAlignment="Right" SelectionChanged="CmbLanguage_SelectionChanged">
                                                    <ComboBoxItem Content="Русский" Tag="ru"/>
                                                    <ComboBoxItem Content="English" Tag="en"/>
                                                    <ComboBoxItem Content="Українська" Tag="uk"/>
                                                    <ComboBoxItem Content="Deutsch" Tag="de"/>
                                                    <ComboBoxItem Content="中文 (简体)" Tag="zh-CN"/>
                                                    <ComboBoxItem Content="中文 (繁體)" Tag="zh-TW"/>
                                                    <ComboBoxItem Content="日本語" Tag="ja"/>
                                                    <ComboBoxItem Content="فارسی" Tag="fa"/>
                                                </ComboBox>
                                            </Grid>

                                            <Grid Margin="0,0,0,16">
                                                <TextBlock x:Name="TxtThemeLabel" Text="Тема оформления" FontSize="16" Foreground="{DynamicResource TextColor}" VerticalAlignment="Center"/>
                                                <ComboBox x:Name="CmbTheme" Width="250" HorizontalAlignment="Right" SelectionChanged="CmbTheme_SelectionChanged">
                                                    <ComboBoxItem Content="Системная" Tag="System"/>
                                                    <ComboBoxItem Content="Темная" Tag="Dark"/>
                                                    <ComboBoxItem Content="Светлая" Tag="Light"/>
                                                </ComboBox>
                                            </Grid>
                                            <CheckBox x:Name="ChkVisualEffects" Content="Включить визуальные эффекты" Checked="ChkVisualEffects_Changed" Unchecked="ChkVisualEffects_Changed" Margin="0,0,0,8" />
                                            <CheckBox x:Name="ChkDisableAnimations" Content="Отключить анимации переходов" Checked="TxtSettings_Changed" Unchecked="TxtSettings_Changed" />
                                        </StackPanel>

                                        <TextBlock x:Name="TxtGroupNetwork" Text="Сеть и Маршрутизация" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource AccentColor}" Margin="0,0,0,8"/>
                                        <Grid Margin="0,0,0,16">
                                            <TextBlock x:Name="TxtDnsLabel" Text="Удаленный DNS (Remote)" FontSize="16" Foreground="{DynamicResource TextColor}" VerticalAlignment="Center"/>
                                            <TextBox x:Name="TxtDns" Width="250" HorizontalAlignment="Right" TextChanged="TxtSettings_Changed" LostFocus="TxtReconnectSetting_LostFocus"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,16">
                                            <TextBlock x:Name="TxtDirectDnsLabel" Text="Прямой DNS (Direct)" FontSize="16" Foreground="{DynamicResource TextColor}" VerticalAlignment="Center"/>
                                            <TextBox x:Name="TxtDirectDns" Width="250" HorizontalAlignment="Right" TextChanged="TxtSettings_Changed" LostFocus="TxtReconnectSetting_LostFocus"/>
                                        </Grid>
                                        <Button Background="{DynamicResource OutlineColor}" Foreground="{DynamicResource PanelColor}" Padding="16,10" Style="{StaticResource M3ButtonStyle}" Click="BtnOpenRouting_Click" HorizontalAlignment="Left" Margin="0,0,0,24">
                                            <StackPanel Orientation="Horizontal" IsHitTestVisible="False">
                                                <TextBlock Text="&#xE71C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock x:Name="TxtBtnRouting" Text="Настроить исключения (Маршруты)" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <TextBlock x:Name="TxtGroupAdvanced" Text="Продвинутые настройки" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource AccentColor}" Margin="0,0,0,8"/>
                                        <StackPanel Margin="0,0,0,12">
                                            <Grid Margin="0,0,0,16">
                                                <TextBlock x:Name="TxtProxyPortLabel" Text="Порт локального прокси" FontSize="16" Foreground="{DynamicResource TextColor}" VerticalAlignment="Center"/>
                                                <TextBox x:Name="TxtProxyPort" Width="250" HorizontalAlignment="Right" TextChanged="TxtSettings_Changed" LostFocus="TxtReconnectSetting_LostFocus" MaxLength="5" PreviewTextInput="NumberValidation"/>
                                            </Grid>
                                            <Grid Margin="0,0,0,16">
                                                <TextBlock x:Name="TxtTunStackLabel" Text="Сетевой стек TUN" FontSize="16" Foreground="{DynamicResource TextColor}" VerticalAlignment="Center"/>
                                                <ComboBox x:Name="CmbTunStack" Width="250" HorizontalAlignment="Right" SelectionChanged="CmbSettings_SelectionChanged">
                                                    <ComboBoxItem Content="system" Tag="system"/>
                                                    <ComboBoxItem Content="gvisor" Tag="gvisor"/>
                                                    <ComboBoxItem Content="mixed" Tag="mixed"/>
                                                </ComboBox>
                                            </Grid>
                                            <CheckBox x:Name="ChkStrictRoute" Content="Строгая маршрутизация TUN (Strict Route)" Checked="ChkTunReconnectSetting_Changed" Unchecked="ChkTunReconnectSetting_Changed" Margin="0,0,0,8"/>
                                            <CheckBox x:Name="ChkEnableIpv6" Content="Поддержка IPv6 (Dual-Stack)" Checked="ChkTunReconnectSetting_Changed" Unchecked="ChkTunReconnectSetting_Changed" Margin="0,0,0,8"/>
                                            <StackPanel Margin="0,0,0,8">
                                                <CheckBox x:Name="ChkAllowLan" Content="Разрешить подключения по локальной сети (LAN)" Checked="ChkReconnectSetting_Changed" Unchecked="ChkReconnectSetting_Changed"/>
                                                <TextBlock x:Name="TxtAllowLanDesc" Text="Позволяет другим устройствам в вашей Wi-Fi сети подключаться к этому прокси." FontSize="12" Foreground="{DynamicResource TextMutedColor}" Margin="32,4,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </StackPanel>

                                    </StackPanel>
                                </Border>
                            </Grid>
                        </ScrollViewer>
                    </Grid>

                    <Grid x:Name="ViewLogs" Grid.Row="0" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock x:Name="TxtLogsTitle" Grid.Row="0" Text="Логи ядра" FontSize="32" FontWeight="Bold" Foreground="{DynamicResource TextColor}" Margin="0,0,0,12"/>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtLogLevelLabel" Text="Уровень: " Foreground="{DynamicResource TextColor}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <ComboBox x:Name="CmbLogLevel" Width="100" Margin="0,0,16,0" SelectionChanged="CmbLogLevel_SelectionChanged">
                                        <ComboBoxItem Content="info" Tag="info"/>
                                        <ComboBoxItem Content="debug" Tag="debug"/>
                                        <ComboBoxItem Content="error" Tag="error"/>
                                    </ComboBox>
                                    <CheckBox x:Name="ChkAutoScroll" Content="Автопрокрутка" IsChecked="True" Foreground="{DynamicResource TextColor}" VerticalAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button x:Name="BtnCopyLogs" Content="Скопировать" Click="BtnCopyLogs_Click" Style="{StaticResource M3ButtonStyle}" Background="{DynamicResource HoverColor}" Foreground="{DynamicResource TextColor}" Padding="16,8" Margin="0,0,12,0"/>
                                    <Button x:Name="BtnClearLogs" Content="Очистить" Click="BtnClearLogs_Click" Style="{StaticResource M3ButtonStyle}" Background="{DynamicResource HoverColor}" Foreground="{DynamicResource TextColor}" Padding="16,8"/>
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <Grid Grid.Row="1">
                            <Border x:Name="LogsConsoleShadow" Background="{DynamicResource ConsoleBgColor}" CornerRadius="12" Opacity="0" IsHitTestVisible="False"/>
                            <Border Background="{DynamicResource ConsoleBgColor}" CornerRadius="12">
                                <RichTextBox x:Name="TxtConsole" IsReadOnly="True" VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0" Padding="16" FontFamily="Consolas" FontSize="13">
                                    <FlowDocument PagePadding="0">
                                        <Paragraph x:Name="ConsoleParagraph"/>
                                    </FlowDocument>
                                </RichTextBox>
                            </Border>
                        </Grid>
                    </Grid>

                    <Grid x:Name="SharedConnectBar" Grid.Row="1" Margin="0,16,0,0" Height="64" Visibility="Visible">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="BtnToggle" Grid.Column="0" Background="{DynamicResource ToggleBtnBgColor}" Foreground="White" Style="{StaticResource RoundM3ButtonStyle}" Click="BtnToggle_Click" RenderTransformOrigin="0.5,0.5">
                            <Button.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Button.RenderTransform>
                            <StackPanel Orientation="Horizontal" IsHitTestVisible="False">
                                <Path Data="M12 1L3 5V11C3 16.55 6.84 21.74 12 23C17.16 21.74 21 16.55 21 11V5L12 1ZM12 20.99C8.03 19.8 5 15.68 5 11.14V6.3L12 3.19L19 6.3V11.14C19 15.68 15.97 19.8 12 20.99Z" Fill="White" Stretch="Uniform" Width="24" Height="24" Margin="0,0,12,0"/>
                                <TextBlock x:Name="BtnToggleText" Text="ВКЛЮЧИТЬ VPN" FontSize="20" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" TextAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Border x:Name="LocationBadge" Grid.Column="1" MaxWidth="0" Opacity="0" Background="Transparent" CornerRadius="12" Margin="0" HorizontalAlignment="Right" ClipToBounds="True">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" MinWidth="160" Margin="16,0">

                                <Grid Width="95" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtSpeedDown" Text="↓ 0 B/s" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextColor}" Margin="0,0,0,2"/>
                                        <TextBlock x:Name="TxtSpeedUp" Text="↑ 0 B/s" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedColor}"/>
                                    </StackPanel>
                                </Grid>

                                <Image x:Name="ImgFlag" Width="32" Height="22" Stretch="UniformToFill" Margin="0,0,12,0" Visibility="Collapsed">
                                    <Image.Clip>
                                        <RectangleGeometry Rect="0,0,32,22" RadiusX="4" RadiusY="4"/>
                                    </Image.Clip>
                                </Image>
                                <Path x:Name="IconLocation" Data="M12 2C8.13 2 5 5.13 5 9C5 14.25 12 22 12 22C12 22 19 14.25 19 9C19 5.13 15.87 2 12 2ZM12 11.5C10.62 11.5 9.5 10.38 9.5 9C9.5 7.62 10.62 6.5 12 6.5C13.38 6.5 14.5 7.62 14.5 9C14.5 10.38 13.38 11.5 12 11.5Z" Fill="{DynamicResource AccentColor}" Stretch="Uniform" Width="24" Height="24" Margin="0,0,12,0"/>

                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtLocation" Text="..." FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextColor}" MaxWidth="180" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="TxtConnectionTime" Text="..." FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedColor}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                </Grid>
            </Grid>

            <Grid x:Name="OverlayImport" Visibility="Collapsed" Background="#00000000" Panel.ZIndex="200">
                <Border x:Name="OverlayImportBg" Background="#B2000000" Opacity="0" MouseDown="OverlayImportBg_MouseDown"/>

                <Grid x:Name="OverlayImportCard" Width="480" VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0">
                    <Grid.RenderTransform>
                        <TranslateTransform x:Name="OverlayImportTransform" Y="30"/>
                    </Grid.RenderTransform>

                    <Border Background="{DynamicResource PanelColor}" CornerRadius="16">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="25" Opacity="0.5" ShadowDepth="8"/>
                        </Border.Effect>
                    </Border>

                    <Border Background="{DynamicResource PanelColor}" CornerRadius="16" Padding="24">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock x:Name="TxtImportTitle" Text="Добавление профиля" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextColor}" Margin="0,0,0,16"/>

                            <Button x:Name="BtnPasteImport" Grid.Row="1" Content="Вставить из буфера обмена" Click="BtnPasteFromClipboard_Click" Style="{StaticResource M3ButtonStyle}" Background="{DynamicResource AccentColor}" Foreground="{DynamicResource OnAccentColor}" Padding="16,12" Margin="0,0,0,24" FontSize="15" FontWeight="SemiBold"/>

                            <Border x:Name="ImportSeparator" Grid.Row="2" Height="1" Background="{DynamicResource OutlineColor}" Opacity="0.3" Margin="0,0,0,24"/>

                            <TextBlock x:Name="TxtOrManual" Grid.Row="3" Text="Или добавить вручную:" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextColor}" Margin="0,0,0,16"/>

                            <ScrollViewer Grid.Row="4" MaxHeight="320" VerticalScrollBarVisibility="Auto" Margin="0,0,0,24" Padding="0,0,8,0">
                                <StackPanel>
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="160"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="TxtProtocolLabel" Text="Протокол" Foreground="{DynamicResource TextColor}" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Column="1" x:Name="CmbProtocol" SelectionChanged="CmbProtocol_SelectionChanged">
                                            <ComboBoxItem Content="vless" IsSelected="True"/>
                                            <ComboBoxItem Content="vmess"/>
                                            <ComboBoxItem Content="trojan"/>
                                            <ComboBoxItem Content="shadowsocks"/>
                                            <ComboBoxItem Content="wireguard"/>
                                            <ComboBoxItem Content="hysteria"/>
                                            <ComboBoxItem Content="hysteria2"/>
                                            <ComboBoxItem Content="tuic"/>
                                            <ComboBoxItem Content="socks"/>
                                            <ComboBoxItem Content="http"/>
                                        </ComboBox>
                                    </Grid>
                                    <StackPanel x:Name="PanelManualFields"/>
                                </StackPanel>
                            </ScrollViewer>

                            <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="BtnCancelImport" Content="Отмена" Click="BtnCancelImport_Click" Style="{StaticResource M3ButtonStyle}" Background="Transparent" Foreground="{DynamicResource TextMutedColor}" Padding="16,10" Margin="0,0,12,0"/>
                                <Button x:Name="BtnSaveImport" Content="Сохранить" Click="BtnSaveImport_Click" Style="{StaticResource M3ButtonStyle}" Background="{DynamicResource OutlineColor}" Foreground="{DynamicResource PanelColor}" FontWeight="Bold" Padding="20,10"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <Grid x:Name="OverlaySubscription" Visibility="Collapsed" Background="#00000000" Panel.ZIndex="205">
                <Border x:Name="OverlaySubscriptionBg" Background="#B2000000" Opacity="0" MouseDown="OverlaySubscriptionBg_MouseDown"/>

                <Grid x:Name="OverlaySubscriptionCard" Width="480" VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0">
                    <Grid.RenderTransform>
                        <TranslateTransform x:Name="OverlaySubscriptionTransform" Y="30"/>
                    </Grid.RenderTransform>

                    <Border Background="{DynamicResource PanelColor}" CornerRadius="16">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="25" Opacity="0.5" ShadowDepth="8"/>
                        </Border.Effect>
                    </Border>

                    <Border Background="{DynamicResource PanelColor}" CornerRadius="16" Padding="24">
                        <StackPanel>
                            <TextBlock x:Name="TxtAddSubTitle" Text="Добавить подписку" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextColor}" Margin="0,0,0,16"/>

                            <TextBlock x:Name="TxtSubNameLabel" Text="Название (необязательно)" FontSize="14" Foreground="{DynamicResource TextMutedColor}" Margin="0,0,0,6"/>
                            <TextBox x:Name="TxtSubscriptionName" Margin="0,0,0,16" Padding="10,8"/>

                            <TextBlock x:Name="TxtSubUrlLabel" Text="Ссылка на подписку (URL)" FontSize="14" Foreground="{DynamicResource TextMutedColor}" Margin="0,0,0,6"/>
                            <TextBox x:Name="TxtSubscriptionUrl" Margin="0,0,0,24" Padding="10,8"/>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="BtnCancelSub" Content="Отмена" Click="BtnCancelSubscription_Click" Style="{StaticResource M3ButtonStyle}" Background="Transparent" Foreground="{DynamicResource TextMutedColor}" Padding="16,10" Margin="0,0,12,0"/>
                                <Button x:Name="BtnSaveSub" Content="Добавить" Click="BtnSaveSubscription_Click" Style="{StaticResource M3ButtonStyle}" Background="{DynamicResource AccentColor}" Foreground="{DynamicResource OnAccentColor}" FontWeight="Bold" Padding="20,10"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <Grid x:Name="OverlayRouting" Visibility="Collapsed" Background="#00000000" Panel.ZIndex="210">
                <Border x:Name="OverlayRoutingBg" Background="#B2000000" Opacity="0" MouseDown="OverlayRoutingBg_MouseDown"/>

                <Grid x:Name="OverlayRoutingCard" Width="500" VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0">
                    <Grid.RenderTransform>
                        <TranslateTransform x:Name="OverlayRoutingTransform" Y="30"/>
                    </Grid.RenderTransform>

                    <Border Background="{DynamicResource PanelColor}" CornerRadius="16">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="25" Opacity="0.5" ShadowDepth="8"/>
                        </Border.Effect>
                    </Border>

                    <Border Background="{DynamicResource PanelColor}" CornerRadius="16" Padding="24">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock x:Name="TxtRoutingTitle" Text="Исключения и правила" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextColor}" Margin="0,0,0,16"/>

                            <StackPanel Grid.Row="1" Margin="0,0,0,24">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="TxtRouteModeLabel" Text="Режим исключений:" Foreground="{DynamicResource TextColor}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                    <ComboBox Grid.Column="1" x:Name="CmbRouteMode" SelectionChanged="CmbRouteMode_SelectionChanged">
                                        <ComboBoxItem Content="Включить для всех, КРОМЕ..."/>
                                        <ComboBoxItem Content="Включить ТОЛЬКО ДЛЯ..."/>
                                    </ComboBox>
                                </Grid>

                                <Border x:Name="BypassRuContainer" ClipToBounds="True" Opacity="1">
                                    <Border.LayoutTransform>
                                        <ScaleTransform x:Name="BypassRuScale" ScaleY="1"/>
                                    </Border.LayoutTransform>
                                    <StackPanel x:Name="BypassRuContent">
                                        <StackPanel.RenderTransform>
                                            <TranslateTransform x:Name="BypassRuTransform" Y="0"/>
                                        </StackPanel.RenderTransform>
                                        <Border Height="1" Background="{DynamicResource OutlineColor}" Opacity="0.3" Margin="0,16,0,8"/>
                                        <CheckBox x:Name="ChkBypassRu" Content="Не проксировать российские сайты (.ru, .рф)"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <ScrollViewer Grid.Row="2" MaxHeight="320" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                                <StackPanel>
                                    <TextBlock x:Name="TxtDomainsLabel" Text="Сайты и домены (например: google.com)" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource AccentColor}" Margin="0,0,0,8"/>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="TxtNewDomain" Margin="0,0,8,0" KeyDown="TxtNewDomain_KeyDown"/>
                                        <Button x:Name="BtnAddDomain" Grid.Column="1" Content="Добавить" Click="BtnAddDomain_Click" Style="{StaticResource M3ButtonStyle}" Background="{DynamicResource OutlineColor}" Foreground="{DynamicResource PanelColor}" Padding="16,0" FontWeight="Bold"/>
                                    </Grid>

                                    <Border Background="{DynamicResource BgColor}" BorderThickness="1" BorderBrush="{DynamicResource OutlineColor}" CornerRadius="8" Padding="4" MinHeight="40" Margin="0,0,0,24">
                                        <ListBox x:Name="ListRoutingDomains" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemContainerStyle="{StaticResource NoHighlightListBoxItemStyle}">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,4" Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ScrollContentPresenter}}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding}" Foreground="{DynamicResource TextColor}" FontSize="14" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                        <Button Grid.Column="1" Style="{StaticResource ListRemoveBtnStyle}" Click="BtnRemoveDomain_Click" Tag="{Binding}" Margin="0,0,16,0">
                                                            <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" FontWeight="Bold" Margin="0,2,0,0"/>
                                                        </Button>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Border>

                                    <TextBlock x:Name="TxtAppsLabel" Text="Приложения (например: telegram.exe)" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource AccentColor}" Margin="0,0,0,8"/>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="TxtNewApp" Margin="0,0,8,0" KeyDown="TxtNewApp_KeyDown"/>
                                        <Button x:Name="BtnAddApp" Grid.Column="1" Content="Добавить" Click="BtnAddApp_Click" Style="{StaticResource M3ButtonStyle}" Background="{DynamicResource OutlineColor}" Foreground="{DynamicResource PanelColor}" Padding="16,0" FontWeight="Bold"/>
                                    </Grid>

                                    <Border Background="{DynamicResource BgColor}" BorderThickness="1" BorderBrush="{DynamicResource OutlineColor}" CornerRadius="8" Padding="4" MinHeight="40" Margin="0,0,0,8">
                                        <ListBox x:Name="ListRoutingApps" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemContainerStyle="{StaticResource NoHighlightListBoxItemStyle}">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,4" Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ScrollContentPresenter}}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding}" Foreground="{DynamicResource TextColor}" FontSize="14" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                        <Button Grid.Column="1" Style="{StaticResource ListRemoveBtnStyle}" Click="BtnRemoveApp_Click" Tag="{Binding}" Margin="0,0,16,0">
                                                            <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" FontWeight="Bold" Margin="0,2,0,0"/>
                                                        </Button>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Border>

                                </StackPanel>
                            </ScrollViewer>

                            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                                <Button x:Name="BtnCloseRouting" Content="Готово" Click="BtnCloseRouting_Click" Style="{StaticResource M3ButtonStyle}" Background="{DynamicResource AccentColor}" Foreground="{DynamicResource OnAccentColor}" FontWeight="Bold" Padding="24,10"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <Grid x:Name="OverlayQR" Visibility="Collapsed" Background="#00000000" Panel.ZIndex="220">
                <Border x:Name="OverlayQRBg" Background="#B2000000" Opacity="0" MouseDown="OverlayQRBg_MouseDown"/>

                <Grid x:Name="OverlayQRCard" Width="320" VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0">
                    <Grid.RenderTransform>
                        <TranslateTransform x:Name="OverlayQRTransform" Y="30"/>
                    </Grid.RenderTransform>

                    <Border Background="{DynamicResource PanelColor}" CornerRadius="16">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="25" Opacity="0.5" ShadowDepth="8"/>
                        </Border.Effect>
                    </Border>

                    <Border Background="{DynamicResource PanelColor}" CornerRadius="16" Padding="24">
                        <StackPanel>
                            <TextBlock x:Name="TxtQRTitle" Text="QR-Код профиля" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextColor}" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                            <Border Background="White" Padding="8" CornerRadius="8" Margin="0,0,0,24" HorizontalAlignment="Center">
                                <Image x:Name="ImgQR" Width="200" Height="200" Stretch="Uniform"/>
                            </Border>
                            <Button x:Name="BtnCopyLinkFromQR" Content="Скопировать ссылку" Click="BtnCopyLinkFromQR_Click" Style="{StaticResource M3ButtonStyle}" Background="{DynamicResource OutlineColor}" Foreground="{DynamicResource PanelColor}" FontWeight="Bold" Padding="16,12"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <Grid x:Name="NotificationSnackbar" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,30" Panel.ZIndex="999" Opacity="0" IsHitTestVisible="False">
                <Border x:Name="NotificationShadowBorder" Background="{DynamicResource PanelColor}" CornerRadius="8">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" Opacity="0.4" ShadowDepth="4"/>
                    </Border.Effect>
                </Border>
                <Border Background="{DynamicResource PanelColor}" BorderBrush="{DynamicResource OutlineColor}" BorderThickness="1" CornerRadius="8" Padding="20,12">
                    <TextBlock x:Name="TxtNotification" Text="..." Foreground="{DynamicResource TextColor}" FontSize="15" FontWeight="Medium"/>
                </Border>
            </Grid>

        </Grid>
    </Border>
</Window>