                    <Border Background="{DynamicResource PanelColor}" CornerRadius="16">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="25" Opacity="0.5" ShadowDepth="8"/>
                        </Border.Effect>
                    </Border>

                    <Border Background="{DynamicResource PanelColor}" CornerRadius="16" Padding="24">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="{DynamicResource Lang_RoutingTitle}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextColor}" Margin="0,0,0,16"/>

                            <Grid Grid.Row="1" Margin="0,0,0,24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource Lang_RoutingMode}" Foreground="{DynamicResource TextColor}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                <ComboBox Grid.Column="1" x:Name="CmbRouteMode">
                                    <ComboBoxItem Content="{DynamicResource Lang_RouteBypass}"/>
                                    <ComboBoxItem Content="{DynamicResource Lang_RouteOnly}"/>
                                </ComboBox>
                            </Grid>

                            <ScrollViewer Grid.Row="2" MaxHeight="350" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Lang_DomainsDesc}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource AccentColor}" Margin="0,0,0,8"/>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="TxtNewDomain" Margin="0,0,8,0" KeyDown="TxtNewDomain_KeyDown"/>
                                        <Button Grid.Column="1" Content="{DynamicResource Lang_Add}" Click="BtnAddDomain_Click" Style="{StaticResource M3ButtonStyle}" Background="{DynamicResource OutlineColor}" Foreground="{DynamicResource PanelColor}" Padding="16,0" FontWeight="Bold"/>
                                    </Grid>

                                    <Border Background="{DynamicResource BgColor}" BorderThickness="1" BorderBrush="{DynamicResource OutlineColor}" CornerRadius="8" Padding="4" MinHeight="40" Margin="0,0,0,24">
                                        <ListBox x:Name="ListRoutingDomains" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemContainerStyle="{StaticResource NoHighlightListBoxItemStyle}">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,4" Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ScrollContentPresenter}}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding}" Foreground="{DynamicResource TextColor}" FontSize="14" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                        <Button Grid.Column="1" Style="{StaticResource ListRemoveBtnStyle}" Click="BtnRemoveDomain_Click" Tag="{Binding}" Margin="0,0,16,0">
                                                            <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" FontWeight="Bold" Margin="0,2,0,0"/>
                                                        </Button>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Border>

                                    <TextBlock Text="{DynamicResource Lang_AppsDesc}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource AccentColor}" Margin="0,0,0,8"/>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="TxtNewApp" Margin="0,0,8,0" KeyDown="TxtNewApp_KeyDown"/>
                                        <Button Grid.Column="1" Content="{DynamicResource Lang_Add}" Click="BtnAddApp_Click" Style="{StaticResource M3ButtonStyle}" Background="{DynamicResource OutlineColor}" Foreground="{DynamicResource PanelColor}" Padding="16,0" FontWeight="Bold"/>
                                    </Grid>

                                    <Border Background="{DynamicResource BgColor}" BorderThickness="1" BorderBrush="{DynamicResource OutlineColor}" CornerRadius="8" Padding="4" MinHeight="40" Margin="0,0,0,8">
                                        <ListBox x:Name="ListRoutingApps" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemContainerStyle="{StaticResource NoHighlightListBoxItemStyle}">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,4" Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ScrollContentPresenter}}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding}" Foreground="{DynamicResource TextColor}" FontSize="14" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                        <Button Grid.Column="1" Style="{StaticResource ListRemoveBtnStyle}" Click="BtnRemoveApp_Click" Tag="{Binding}" Margin="0,0,16,0">
                                                            <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" FontWeight="Bold" Margin="0,2,0,0"/>
                                                        </Button>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Border>

                                </StackPanel>
                            </ScrollViewer>

                            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                                <Button Content="{DynamicResource Lang_Done}" Click="BtnCloseRouting_Click" Style="{StaticResource M3ButtonStyle}" Background="{DynamicResource AccentColor}" Foreground="{DynamicResource OnAccentColor}" FontWeight="Bold" Padding="24,10"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <Grid x:Name="OverlayQR" Visibility="Collapsed" Background="#00000000" Panel.ZIndex="220">
                <Border x:Name="OverlayQRBg" Background="#B2000000" Opacity="0" MouseDown="OverlayQRBg_MouseDown"/>

                <Grid x:Name="OverlayQRCard" Width="320" VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0">
                    <Grid.RenderTransform>
                        <TranslateTransform x:Name="OverlayQRTransform" Y="30"/>
                    </Grid.RenderTransform>

                    <Border Background="{DynamicResource PanelColor}" CornerRadius="16">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="25" Opacity="0.5" ShadowDepth="8"/>
                        </Border.Effect>
                    </Border>

                    <Border Background="{DynamicResource PanelColor}" CornerRadius="16" Padding="24">
                        <StackPanel>
                            <TextBlock x:Name="TxtQRTitle" Text="{DynamicResource Lang_QRTitle}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextColor}" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                            <Border Background="White" Padding="8" CornerRadius="8" Margin="0,0,0,24" HorizontalAlignment="Center">
                                <Image x:Name="ImgQR" Width="200" Height="200" Stretch="Uniform"/>
                            </Border>
                            <Button Content="{DynamicResource Lang_CopyLink}" Click="BtnCopyLinkFromQR_Click" Style="{StaticResource M3ButtonStyle}" Background="{DynamicResource OutlineColor}" Foreground="{DynamicResource PanelColor}" FontWeight="Bold" Padding="16,12"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <Grid x:Name="NotificationSnackbar" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,30" Panel.ZIndex="999" Opacity="0" IsHitTestVisible="False">
                <Border Background="{DynamicResource PanelColor}" CornerRadius="8">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" Opacity="0.4" ShadowDepth="4"/>
                    </Border.Effect>
                </Border>
                <Border Background="{DynamicResource PanelColor}" BorderBrush="{DynamicResource OutlineColor}" BorderThickness="1" CornerRadius="8" Padding="20,12">
                    <TextBlock x:Name="TxtNotification" Text="..." Foreground="{DynamicResource TextColor}" FontSize="15" FontWeight="Medium"/>
                </Border>
            </Grid>

        </Grid>
    </Border>
</Window>