                                            <ComboBoxItem Content="trojan"/>
                                            <ComboBoxItem Content="shadowsocks"/>
                                            <ComboBoxItem Content="wireguard"/>
                                            <ComboBoxItem Content="hysteria"/>
                                            <ComboBoxItem Content="hysteria2"/>
                                            <ComboBoxItem Content="tuic"/>
                                            <ComboBoxItem Content="socks"/>
                                            <ComboBoxItem Content="http"/>
                                        </ComboBox>
                                    </Grid>
                                    <StackPanel x:Name="PanelManualFields"/>
                                </StackPanel>
                            </ScrollViewer>

                            <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="{DynamicResource Lang_Cancel}" Click="BtnCancelImport_Click" Style="{StaticResource M3ButtonStyle}" Background="Transparent" Foreground="{DynamicResource TextMutedColor}" Padding="16,10" Margin="0,0,12,0"/>
                                <Button Content="{DynamicResource Lang_Save}" Click="BtnSaveImport_Click" Style="{StaticResource M3ButtonStyle}" Background="{DynamicResource OutlineColor}" Foreground="{DynamicResource PanelColor}" FontWeight="Bold" Padding="20,10"/>
